{
  "openapi": "3.0.0",
  "paths": {
    "/health/live": {
      "get": {
        "operationId": "HealthController_live",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponseDto"
                }
              }
            }
          }
        },
        "summary": "Process liveness",
        "tags": [
          "health"
        ]
      }
    },
    "/health/ready": {
      "get": {
        "operationId": "HealthController_ready",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponseDto"
                }
              }
            }
          },
          "503": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponseDto"
                }
              }
            }
          }
        },
        "summary": "Database and extension readiness",
        "tags": [
          "health"
        ]
      }
    },
    "/search": {
      "get": {
        "operationId": "SearchController_search",
        "parameters": [
          {
            "name": "type",
            "required": false,
            "in": "query",
            "schema": {
              "enum": [
                "artist",
                "album",
                "recording"
              ],
              "type": "string"
            }
          },
          {
            "name": "limit",
            "required": false,
            "in": "query",
            "schema": {
              "minimum": 1,
              "maximum": 50,
              "type": "number"
            }
          },
          {
            "name": "q",
            "required": true,
            "in": "query",
            "schema": {
              "minLength": 1,
              "maxLength": 120,
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "oneOf": [
                      {
                        "$ref": "#/components/schemas/ArtistSearchResultDto"
                      },
                      {
                        "$ref": "#/components/schemas/AlbumSearchResultDto"
                      },
                      {
                        "$ref": "#/components/schemas/RecordingSearchResultDto"
                      }
                    ],
                    "discriminator": {
                      "propertyName": "kind"
                    }
                  }
                }
              }
            }
          }
        },
        "summary": "Search the local Yara Catalog projection",
        "tags": [
          "catalog"
        ]
      }
    },
    "/artists/{id}": {
      "get": {
        "operationId": "CatalogController_artist",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ArtistDetailDto"
                }
              }
            }
          },
          "404": {
            "description": "Artist not found"
          }
        },
        "summary": "Read canonical Artist detail",
        "tags": [
          "catalog"
        ]
      }
    },
    "/albums/{id}": {
      "get": {
        "operationId": "CatalogController_album",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AlbumDetailDto"
                }
              }
            }
          },
          "404": {
            "description": "Album not found"
          }
        },
        "summary": "Read canonical Album detail with ordered recordings",
        "tags": [
          "catalog"
        ]
      }
    },
    "/recordings/{id}": {
      "get": {
        "operationId": "CatalogController_recording",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecordingDetailDto"
                }
              }
            }
          },
          "404": {
            "description": "Recording not found"
          }
        },
        "summary": "Read canonical Recording detail and Album contexts",
        "tags": [
          "catalog"
        ]
      }
    },
    "/conversations/start": {
      "post": {
        "operationId": "YaraController_startConversation",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StartConversationDto"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SendConversationMessageResponseDto"
                }
              }
            }
          }
        },
        "summary": "Atomically start a conversation with durable AI execution intent",
        "tags": [
          "yara"
        ]
      }
    },
    "/conversations": {
      "post": {
        "operationId": "YaraController_createConversation",
        "parameters": [],
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateConversationResponseDto"
                }
              }
            }
          }
        },
        "summary": "Create an owned Yara conversation",
        "tags": [
          "yara"
        ]
      },
      "get": {
        "operationId": "YaraController_listConversations",
        "parameters": [
          {
            "name": "limit",
            "required": false,
            "in": "query",
            "schema": {
              "minimum": 1,
              "maximum": 50,
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListConversationsResponseDto"
                }
              }
            }
          }
        },
        "summary": "List recent meaningful Yara conversations for the current owner",
        "tags": [
          "yara"
        ]
      }
    },
    "/conversations/{id}": {
      "get": {
        "operationId": "YaraController_getConversation",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/YaraConversationDto"
                }
              }
            }
          },
          "404": {
            "description": ""
          }
        },
        "summary": "Read durable committed conversation state",
        "tags": [
          "yara"
        ]
      }
    },
    "/conversations/{id}/messages": {
      "post": {
        "operationId": "YaraController_sendMessage",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SendConversationMessageDto"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SendConversationMessageResponseDto"
                }
              }
            }
          }
        },
        "summary": "Commit a user message and start a separate AI execution run",
        "tags": [
          "yara"
        ]
      }
    },
    "/ai-runs/{id}": {
      "get": {
        "operationId": "YaraController_getRun",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AIExecutionRunResponseDto"
                }
              }
            }
          }
        },
        "summary": "Poll the authoritative AI execution run state",
        "tags": [
          "yara"
        ]
      }
    },
    "/ai-runs/{id}/cancel": {
      "post": {
        "operationId": "YaraController_cancelRun",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AIExecutionRunResponseDto"
                }
              }
            }
          }
        },
        "summary": "Cancel a pending or running execution without treating disconnect as cancel",
        "tags": [
          "yara"
        ]
      }
    },
    "/ai-runs/{id}/events": {
      "get": {
        "operationId": "YaraController_streamRun",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "last-event-id",
            "required": true,
            "in": "header",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "summary": "Stream replayable Yara-owned run events using SSE sequence cursors",
        "tags": [
          "yara"
        ]
      }
    }
  },
  "info": {
    "title": "Yara API",
    "version": "0.0.0"
  },
  "components": {
    "schemas": {
      "HealthResponseDto": {
        "type": "object",
        "properties": {
          "service": {
            "type": "string",
            "enum": [
              "api"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "degraded"
            ]
          },
          "version": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "checks": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "enum": [
                "ok",
                "degraded"
              ]
            }
          }
        },
        "required": [
          "service",
          "status",
          "version",
          "timestamp"
        ]
      },
      "CatalogImageDto": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "format": "uri"
          },
          "provider": {
            "type": "string"
          },
          "sourceRef": {
            "type": "string"
          }
        },
        "required": [
          "url"
        ]
      },
      "ArtistSearchResultDto": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "artist"
            ]
          },
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "image": {
            "$ref": "#/components/schemas/CatalogImageDto"
          }
        },
        "required": [
          "kind",
          "id",
          "name"
        ]
      },
      "ArtistSummaryDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name"
        ]
      },
      "AlbumSearchResultDto": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "album"
            ]
          },
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "artists": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ArtistSummaryDto"
            }
          },
          "originalReleaseYear": {
            "type": "number"
          },
          "cover": {
            "$ref": "#/components/schemas/CatalogImageDto"
          }
        },
        "required": [
          "kind",
          "id",
          "title",
          "artists"
        ]
      },
      "AlbumContextSummaryDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "cover": {
            "$ref": "#/components/schemas/CatalogImageDto"
          }
        },
        "required": [
          "id",
          "title"
        ]
      },
      "RecordingSearchResultDto": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "recording"
            ]
          },
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "artists": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ArtistSummaryDto"
            }
          },
          "durationMs": {
            "type": "number"
          },
          "albumContext": {
            "$ref": "#/components/schemas/AlbumContextSummaryDto"
          },
          "artwork": {
            "$ref": "#/components/schemas/CatalogImageDto"
          }
        },
        "required": [
          "kind",
          "id",
          "title",
          "artists"
        ]
      },
      "ArtistDetailDto": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "artist"
            ]
          },
          "id": {
            "type": "string"
          },
          "canonicalName": {
            "type": "string"
          },
          "image": {
            "$ref": "#/components/schemas/CatalogImageDto"
          }
        },
        "required": [
          "kind",
          "id",
          "canonicalName"
        ]
      },
      "RecordingDetailSummaryDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "artists": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ArtistSummaryDto"
            }
          },
          "durationMs": {
            "type": "number"
          },
          "position": {
            "type": "number"
          }
        },
        "required": [
          "id",
          "title",
          "artists",
          "position"
        ]
      },
      "AlbumDetailDto": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "album"
            ]
          },
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "artists": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ArtistSummaryDto"
            }
          },
          "originalReleaseYear": {
            "type": "number"
          },
          "cover": {
            "$ref": "#/components/schemas/CatalogImageDto"
          },
          "trackCount": {
            "type": "number"
          },
          "recordings": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RecordingDetailSummaryDto"
            }
          }
        },
        "required": [
          "kind",
          "id",
          "title",
          "artists",
          "trackCount",
          "recordings"
        ]
      },
      "RecordingDetailDto": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "recording"
            ]
          },
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "artists": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ArtistSummaryDto"
            }
          },
          "durationMs": {
            "type": "number"
          },
          "albumContexts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AlbumContextSummaryDto"
            }
          }
        },
        "required": [
          "kind",
          "id",
          "title",
          "artists",
          "albumContexts"
        ]
      },
      "StartConversationDto": {
        "type": "object",
        "properties": {
          "content": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000,
            "example": "Why does this song feel so spacious?"
          },
          "idempotencyKey": {
            "type": "string",
            "minLength": 8,
            "maxLength": 200
          }
        },
        "required": [
          "content",
          "idempotencyKey"
        ]
      },
      "SendConversationMessageResponseDto": {
        "type": "object",
        "properties": {
          "conversationId": {
            "type": "string"
          },
          "messageId": {
            "type": "string"
          },
          "runId": {
            "type": "string"
          }
        },
        "required": [
          "conversationId",
          "messageId",
          "runId"
        ]
      },
      "ConversationMessageDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "conversationId": {
            "type": "string"
          },
          "sequence": {
            "type": "number"
          },
          "role": {
            "type": "string",
            "enum": [
              "user",
              "assistant"
            ]
          },
          "content": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "committed"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "conversationId",
          "sequence",
          "role",
          "content",
          "status",
          "createdAt"
        ]
      },
      "AIExecutionFailureDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ]
      },
      "AIExecutionRunDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "conversationId": {
            "type": "string"
          },
          "triggerMessageId": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "running",
              "completed",
              "failed",
              "cancelled"
            ]
          },
          "provider": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "failure": {
            "$ref": "#/components/schemas/AIExecutionFailureDto"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "startedAt": {
            "type": "string",
            "format": "date-time"
          },
          "finishedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "conversationId",
          "triggerMessageId",
          "status",
          "provider",
          "model",
          "createdAt"
        ]
      },
      "YaraConversationDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "archived"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "messages": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ConversationMessageDto"
            }
          },
          "activeRun": {
            "$ref": "#/components/schemas/AIExecutionRunDto"
          }
        },
        "required": [
          "id",
          "status",
          "createdAt",
          "updatedAt",
          "messages"
        ]
      },
      "CreateConversationResponseDto": {
        "type": "object",
        "properties": {
          "conversation": {
            "$ref": "#/components/schemas/YaraConversationDto"
          }
        },
        "required": [
          "conversation"
        ]
      },
      "YaraConversationSummaryDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "title": {
            "type": "string"
          },
          "preview": {
            "type": "string"
          },
          "messageCount": {
            "type": "number",
            "minimum": 1
          },
          "lastMessageRole": {
            "type": "string",
            "enum": [
              "user",
              "assistant"
            ]
          },
          "activeRunId": {
            "type": "string"
          },
          "activeRunStatus": {
            "type": "string",
            "enum": [
              "pending",
              "running"
            ]
          }
        },
        "required": [
          "id",
          "updatedAt",
          "title",
          "preview",
          "messageCount",
          "lastMessageRole"
        ]
      },
      "ListConversationsResponseDto": {
        "type": "object",
        "properties": {
          "conversations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/YaraConversationSummaryDto"
            }
          }
        },
        "required": [
          "conversations"
        ]
      },
      "SendConversationMessageDto": {
        "type": "object",
        "properties": {
          "content": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000,
            "example": "Why does this song feel so spacious?"
          },
          "idempotencyKey": {
            "type": "string",
            "minLength": 8,
            "maxLength": 200
          }
        },
        "required": [
          "content",
          "idempotencyKey"
        ]
      },
      "AIExecutionRunResponseDto": {
        "type": "object",
        "properties": {
          "run": {
            "$ref": "#/components/schemas/AIExecutionRunDto"
          },
          "assistantMessage": {
            "$ref": "#/components/schemas/ConversationMessageDto"
          }
        },
        "required": [
          "run"
        ]
      }
    }
  }
}
